# 1，系统随机生成一个随机数
# 2，用户根据提示猜数字，并将所猜的数字输入系统
# 3.如果猜错，系统给出提示是猜大了，还是猜小了，然后继续输入猜的数字
# 4，如果猜对，系统自动退出，游戏结束

#事先导入random
import random
random_num = random.randint(1,100)#生成随机数


while True:
    try:
        num = int(input("请输入猜的数字"))
    except ValueError:
        print("请输入一个有效的整数！")
        continue

    if(random_num > num):
        print("您输入的数字小了")

    elif(random_num < num):
        print("您输入的数字大了")

    else:
        print("恭喜您猜对了")
        break


